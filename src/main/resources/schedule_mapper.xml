<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="bo">

    <!-- 일정 추가 -->
    <insert id="addTravel">

    </insert>

    <!-- 일정 조회 -->
    <select id="getMyTravel" resultType="com.ta.travel_agent.schedule.TravelDTO">
        select *
        from travel, region
        where t_r_no = r_no
        and t_u_id = #{id}
        order by t_updated_date desc
    </select>

    <select id="getOthersTravel" resultType="com.ta.travel_agent.schedule.TravelDTO">
        select *
        from travel, region
        where t_r_no = r_no
        and t_u_id != #{id}
        order by t_updated_date desc
    </select>

    <select id="getAllPlace" resultType="com.ta.travel_agent.schedule.spot.ScheduleSpotDTO">
        select *
        from SCHEDULE, SCHEDULE_PLACE, SPOT
        where s_p_s_no = s_no
        AND S_P_SPOT_NO = spot_no
        AND s_t_no = #{travel_no}
    </select>

    <!-- 장소 조회 spot api관련 -->
    <select id="getSpotDetail" resultType="com.ta.travel_agent.schedule.spot.SpotDTO">
        select * from spot where spot_no = #{spot_no}
    </select>


</mapper>


